NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APIFY_TOKEN=
APIFY_TWEET_SCRAPER_ACTOR=apidojo/tweet-scraper
CRON_SECRET=
# Phase 1: set to "true" to enable opt-in AdsPower posting
NEXT_PUBLIC_POSTING_ENABLED=

# Telegram alerts (pulse + nudge + sniper)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web push (P5 sniper) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
SNIPER_MIN_SCORE=0.6
# Rolling signal_tweets warehouse retention window, days (GDPR LIA R1)
SIGNAL_RETENTION_DAYS=90
# Sniper one-tap reply: set to "1" so notifications deep-link into X's native
# composer pre-filled with the drafted reply (still manual-send — the human taps
# Post). Unset/any other value falls back to a bare open-tweet status URL, leaving
# the headline reply-intent feature dark. Set this on Vercel prod too.
REPLY_INTENT_ENABLED=1

# Auth (feat/auth-layer). Sign-up on the public /login page is CLOSED unless the
# email is listed here (comma-separated, case-insensitive). Sign-in is unaffected.
# Leave unset in prod once the owner account exists.
AUTH_SIGNUP_ALLOWLIST=
# Pins the deployment to one profile row. With auth on, a signed-in user who owns
# no profile is told to link this row (see docs/runbooks/2026-09-10-auth-merge-runbook.md)
# rather than getting a fresh empty one.
FIXED_PROFILE_ID=
